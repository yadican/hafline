{
    "openapi": "3.0.0",
    "info": {
        "title": "Hafline API",
        "description": "Hafline v1 HTTP API (JWT Bearer token).",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8010",
            "description": "Application server"
        }
    ],
    "paths": {
        "/api/v1/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login and receive a JWT",
                "operationId": "authLogin",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Authenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Invalidate the current JWT",
                "operationId": "authLogout",
                "responses": {
                    "200": {
                        "description": "Logged out",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MessageResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthenticatedError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/dashboard": {
            "get": {
                "tags": [
                    "Dashboard"
                ],
                "summary": "Get dashboard summary for the authenticated user",
                "operationId": "dashboardShow",
                "responses": {
                    "200": {
                        "description": "Dashboard payload",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DashboardResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthenticatedError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/field-sessions": {
            "post": {
                "tags": [
                    "FieldSessions"
                ],
                "summary": "Lock site, dump site and shift for the field operator session",
                "description": "Pick values from GET /hauls/options (sites, shifts) and GET /hauls/dump-sites?site_id=… then POST them here to lock the operator session on the server.",
                "operationId": "fieldSessionsLock",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "site_id",
                                    "dump_site_id",
                                    "shift"
                                ],
                                "properties": {
                                    "site_id": {
                                        "type": "string",
                                        "format": "uuid",
                                        "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                                    },
                                    "dump_site_id": {
                                        "type": "string",
                                        "format": "uuid",
                                        "example": "b2c3d4e5-f6a7-8901-bcde-f12345678901"
                                    },
                                    "shift": {
                                        "type": "string",
                                        "example": "day",
                                        "enum": [
                                            "day",
                                            "night"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Session locked"
                    },
                    "422": {
                        "description": "Validation failed"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/field-sessions/current": {
            "get": {
                "tags": [
                    "FieldSessions"
                ],
                "summary": "Get the operator active field session",
                "operationId": "fieldSessionsCurrent",
                "responses": {
                    "200": {
                        "description": "Active session or null data"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "FieldSessions"
                ],
                "summary": "Close the active field session",
                "operationId": "fieldSessionsClose",
                "responses": {
                    "200": {
                        "description": "Session closed"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/hauls/options": {
            "get": {
                "tags": [
                    "Hauls"
                ],
                "summary": "Sites and shifts for a field session",
                "operationId": "haulsOptions",
                "responses": {
                    "200": {
                        "description": "Session option lists"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/hauls/dump-sites": {
            "get": {
                "tags": [
                    "Hauls"
                ],
                "summary": "Dump sites with an active route for the given site",
                "operationId": "haulsDumpSites",
                "parameters": [
                    {
                        "name": "site_id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Dump site list"
                    },
                    "422": {
                        "description": "Validation failed"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/hauls/scan": {
            "post": {
                "tags": [
                    "Hauls"
                ],
                "summary": "Upload a plate photo, store it privately, and run OCR",
                "operationId": "haulsScan",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "file",
                                    "field_session_id"
                                ],
                                "properties": {
                                    "file": {
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "field_session_id": {
                                        "description": "Active field session id",
                                        "type": "string",
                                        "format": "uuid"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Scan result"
                    },
                    "422": {
                        "description": "Invalid image or missing session"
                    },
                    "429": {
                        "description": "Too many requests"
                    },
                    "502": {
                        "description": "OCR unavailable"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/hauls": {
            "post": {
                "tags": [
                    "Hauls"
                ],
                "summary": "Create a haul from a confirmed plate scan",
                "description": "Site/dump/shift come from the locked field session. Send only plate, scan_id and field_session_id.",
                "operationId": "haulsStore",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "plate",
                                    "scan_id",
                                    "field_session_id"
                                ],
                                "properties": {
                                    "plate": {
                                        "type": "string",
                                        "example": "34 ABC 123"
                                    },
                                    "scan_id": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "field_session_id": {
                                        "description": "id from POST /field-sessions",
                                        "type": "string",
                                        "format": "uuid"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Haul created with print payload"
                    },
                    "422": {
                        "description": "Validation failed"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/hauls/session": {
            "get": {
                "tags": [
                    "Hauls"
                ],
                "summary": "Today hauls for the locked site / dump / shift session",
                "description": "Requires an open field session. List is filtered automatically by that session site_id, dump_site_id and shift.",
                "operationId": "haulsSession",
                "responses": {
                    "200": {
                        "description": "Session context + haul list"
                    },
                    "422": {
                        "description": "No active field session"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/hauls/{haul}": {
            "get": {
                "tags": [
                    "Hauls"
                ],
                "summary": "Print DTO for a haul",
                "operationId": "haulsShow",
                "parameters": [
                    {
                        "name": "haul",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Print payload"
                    },
                    "404": {
                        "description": "Not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/hauls/{haul}/photo": {
            "get": {
                "tags": [
                    "Hauls"
                ],
                "summary": "Private haul photo (signed URL)",
                "operationId": "haulsPhoto",
                "parameters": [
                    {
                        "name": "haul",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "expires",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "signature",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "JPEG image"
                    },
                    "403": {
                        "description": "Invalid signature"
                    },
                    "404": {
                        "description": "Not found"
                    }
                }
            }
        },
        "/api/v1/me": {
            "get": {
                "tags": [
                    "Profile"
                ],
                "summary": "Get the authenticated user",
                "operationId": "profileShow",
                "responses": {
                    "200": {
                        "description": "Current user",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UserResourceResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthenticatedError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "required": [
                    "id",
                    "name",
                    "username"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Ada Lovelace"
                    },
                    "username": {
                        "type": "string",
                        "example": "ada",
                        "nullable": true
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "ada@hafline.test",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "LoginRequest": {
                "required": [
                    "login",
                    "password"
                ],
                "properties": {
                    "login": {
                        "description": "Email or username",
                        "type": "string",
                        "example": "admin@hafline.test"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "password"
                    }
                },
                "type": "object"
            },
            "LoginResponse": {
                "required": [
                    "token",
                    "token_type",
                    "expires_in",
                    "user"
                ],
                "properties": {
                    "token": {
                        "type": "string",
                        "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJodHRwOi8vbG9jYWxob3N0In0.signature"
                    },
                    "token_type": {
                        "type": "string",
                        "example": "Bearer"
                    },
                    "expires_in": {
                        "description": "Seconds until the JWT expires",
                        "type": "integer",
                        "example": 3600
                    },
                    "user": {
                        "$ref": "#/components/schemas/User"
                    }
                },
                "type": "object"
            },
            "ValidationError": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "login zorunludur. (and 1 more error)"
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "type": "object"
            },
            "UnauthenticatedError": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Unauthenticated."
                    }
                },
                "type": "object"
            },
            "MessageResponse": {
                "required": [
                    "message"
                ],
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Çıkış yapıldı."
                    }
                },
                "type": "object"
            },
            "UserResourceResponse": {
                "required": [
                    "data"
                ],
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/User"
                    }
                },
                "type": "object"
            },
            "DashboardResponse": {
                "required": [
                    "user",
                    "counts"
                ],
                "properties": {
                    "user": {
                        "$ref": "#/components/schemas/User"
                    },
                    "counts": {
                        "required": [
                            "sites",
                            "vehicles",
                            "hauls"
                        ],
                        "properties": {
                            "sites": {
                                "type": "integer",
                                "example": 0
                            },
                            "vehicles": {
                                "type": "integer",
                                "example": 0
                            },
                            "hauls": {
                                "type": "integer",
                                "example": 0
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Paste the JWT returned by POST /api/v1/auth/login (without the Bearer prefix).",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Authentication"
        },
        {
            "name": "Profile",
            "description": "Authenticated user profile"
        },
        {
            "name": "Dashboard",
            "description": "Dashboard summary"
        },
        {
            "name": "Hauls",
            "description": "Field haul scan and ticket creation"
        },
        {
            "name": "FieldSessions",
            "description": "Locked site / dump / shift session for field operators"
        }
    ]
}