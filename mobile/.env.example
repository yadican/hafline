# Copy to .env.local (per machine, not committed), then run `npm run dev`. See docs/run.md.

# Address phones use to reach this computer.
#   auto       -> detected on every start (Wi-Fi, customer Wi-Fi, phone hotspot)
#   10.0.0.25  -> fixed address, if auto picks the wrong network
DEV_HOST_IP=auto

METRO_PORT=8081
# Must match the Laravel port published in ../compose.yaml.
API_PORT=8010

# Optional: point the app at another API instead of this computer (e.g. a test server).
# API_URL=https://api.example.com
